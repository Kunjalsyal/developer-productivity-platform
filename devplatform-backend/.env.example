DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devplatform
# Optional: require this value in the X-API-Key header on every /api request
API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

GITHUB_TOKEN=
NOTION_TOKEN=

# sentence-transformers (real) | hash (dev/tests only, lexical)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# groq (free) | ollama (local) | anthropic | openai | fake (fake = no API calls)
LLM_PROVIDER=groq
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=

# Retrieval / confidence tuning (calibrate with scripts/eval_search.py)
TOP_K=8
MAX_CONTEXT_CHUNKS=6
MIN_SIMILARITY=0.30
MIN_SUPPORTING_CHUNKS=1
